<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingStart="14dp"
    android:paddingEnd="14dp"
    android:paddingTop="12dp"
    android:paddingBottom="12dp"
    android:background="@drawable/bg_autofill_chip">

    <ImageView
        android:id="@+id/autofill_auth_icon"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:src="@drawable/ic_fingerprint"
        android:contentDescription="@string/biometric_prompt_title" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingEnd="8dp">

        <TextView
            android:id="@+id/autofill_auth_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Unlock SecureVault"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/autofill_auth_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Biometric / PIN required to autofill"
            android:textColor="#10B981"
            android:textSize="12sp" />
    </LinearLayout>

    <ImageView
        android:layout_width="18dp"
        android:layout_height="18dp"
        android:src="@drawable/ic_key"
        android:contentDescription="Locked" />
</LinearLayout>
